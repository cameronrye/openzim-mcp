---
import { getCollection } from 'astro:content';
import { GROUP_ORDER, sortDocsForNav } from '../lib/docs-order';

// Same sort as PrevNext, from the same module, so the sidebar's reading order
// and the footer's prev/next chain cannot drift apart again.
const allDocs = sortDocsForNav(await getCollection('docs'));
const groups: Record<string, typeof allDocs> = {};
for (const doc of allDocs) {
  (groups[doc.data.group] ??= []).push(doc);
}
const orderedGroups = GROUP_ORDER;
const { currentSlug } = Astro.props as { currentSlug: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="docs-sidebar-wrap">
<button
  class="docs-sidebar-toggle"
  id="docs-sidebar-toggle"
  type="button"
  aria-controls="docs-sidebar-nav"
  aria-expanded="true"
>Documentation menu</button>
<nav class="docs-sidebar" id="docs-sidebar-nav" aria-label="Documentation">
  {orderedGroups.map((g) =>
    groups[g] && (
      <section>
        <h3>{g}</h3>
        <ul>
          {groups[g].map((d) => (
            <li>
              <a
                href={`${base}/docs/${d.id === 'index' ? '' : d.id + '/'}`}
                aria-current={d.id === currentSlug ? 'page' : undefined}
              >{d.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  )}
</nav>
</div>
